<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FastPortDashboard.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:FastPortDashboard.Maui.Views"
    Shell.FlyoutBehavior="Disabled">

    <!-- Design Ref: §2.2 — 2-탭 shell via Shell.TabBar.
         Tab 1: JSONL Polling (직전 cycle 무손실 이전), Tab 2: Echo Client (NEW). -->
    <TabBar>
        <ShellContent Title="JSONL Polling"
                      ContentTemplate="{DataTemplate views:JsonlPollingPage}"
                      Route="JsonlPolling" />
        <ShellContent Title="Echo Client"
                      ContentTemplate="{DataTemplate views:EchoClientPage}"
                      Route="EchoClient" />
    </TabBar>

</Shell>
