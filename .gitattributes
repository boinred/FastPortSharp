# Cross-platform line-ending and encoding policy for FastPortSharp.
# Design Ref: game-server-template-scaffold-scripts §3.5.
#
# Goal: byte-identical scaffold output across Linux/macOS/Windows so the
# 3-environment CI matrix (`.github/workflows/scaffold.yml`) can verify
# parity via sha256 diff.

# Default: text auto-detected, normalized to LF on commit.
* text=auto eol=lf

# Source code — explicitly LF.
*.cs       text eol=lf
*.csproj   text eol=lf
*.proto    text eol=lf
*.json     text eol=lf
*.md       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.txt      text eol=lf

# Shell / PowerShell — LF (PS7 reads LF on Windows just fine).
*.sh       text eol=lf
*.ps1      text eol=lf

# Solution files — Visual Studio prefers CRLF; `dotnet new sln` emits CRLF.
*.sln      text eol=crlf

# Binary — never normalize.
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.dll      binary
*.exe      binary
*.zip      binary
*.tar      binary
*.gz       binary
