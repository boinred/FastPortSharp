<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Sample console client for FastPortGameServerTemplate.
    Connects to the template server, sends EchoRequest(1001), prints EchoResponse(1002), exits.
    Reference: docs/03-analysis/...analysis.md I-2 — full Protobuf round-trip verification.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>FastPortGameServerTemplate.SampleClient</RootNamespace>
    <AssemblyName>FastPortGameServerTemplate.SampleClient</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.7" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="8.0.4" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <!-- Design Ref: protos-shared-folder-revert-contracts §10.1 —
         Per-consumer protobuf code generation from shared Protos/ folder. -->
    <PackageReference Include="Google.Protobuf" Version="3.32.1" />
    <PackageReference Include="Google.Protobuf.Tools" Version="3.32.1" />
    <PackageReference Include="Grpc.Tools" Version="2.71.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Generate Sample.cs + PacketIds enum from shared protos into this assembly. -->
    <Protobuf Include="..\Protos\*.proto"
              ProtoRoot="..\Protos"
              GrpcServices="None"
              Access="Public" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\LibCommons\LibCommons.csproj" />
    <ProjectReference Include="..\..\LibNetworks\LibNetworks.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
