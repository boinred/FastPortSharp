<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Sample console client for FastPortGameServerTemplate.
    Connects to the template server, sends EchoRequest(1001), prints EchoResponse(1002), exits.
    Reference: docs/03-analysis/...analysis.md I-2 — full Protobuf round-trip verification.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>FastPortGameServerTemplate.SampleClient</RootNamespace>
    <AssemblyName>FastPortGameServerTemplate.SampleClient</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.7" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="8.0.4" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Google.Protobuf" Version="3.32.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\LibCommons\LibCommons.csproj" />
    <ProjectReference Include="..\..\LibNetworks\LibNetworks.csproj" />
    <!-- Design Ref: template-contracts-extraction §2.3 —
         Contracts lib에서 Sample.proto + PacketIds 직접 획득 (Template Exe 참조 안티패턴 해소). -->
    <ProjectReference Include="..\FastPortGameServerTemplate.Contracts\FastPortGameServerTemplate.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
